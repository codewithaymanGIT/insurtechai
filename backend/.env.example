DATABASE_URL="file:./dev.db"
PORT=4000

# Where the frontend runs. Used for CORS and for rejecting cross-site
# requests. Comma-separate several (e.g. your production domain + localhost).
APP_ORIGIN="http://localhost:5173"

# Signs sign-in codes. Required in production: any random string of 32+
# characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=

# Emails that get the ADMIN role on sign-in (comma-separated). Admins can see
# the usage panel in the insurer workspace.
ADMIN_EMAILS=

# --- Sign in with Google (optional) ----------------------------------------
# Create an OAuth client ID (type "Web application") at
# https://console.cloud.google.com/apis/credentials and add your frontend URL
# (http://localhost:5173 for local) under "Authorized JavaScript origins".
# Only the client ID is needed; it's not a secret.
GOOGLE_CLIENT_ID=

# --- Email sign-in codes ---------------------------------------------------
# Without SMTP settings, codes are printed in the backend terminal (local
# development only; in production, email sign-in is disabled until set).
# Gmail: turn on 2-Step Verification, create an App Password at
# https://myaccount.google.com/apppasswords and use it as SMTP_PASS.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=

# --- AI chat (optional) ----------------------------------------------------
# Google Gemini key from https://aistudio.google.com/apikey. Without it the
# chat box shows as offline; everything else works.
GEMINI_API_KEY=
# On the free tier, Google may use what's sent to improve its products and
# human reviewers may read it. Before publishing, enable billing on the key's
# Google Cloud project (paid tier: prompts aren't used for training) and set
# this to true. The site tells visitors which applies.
GEMINI_PAID_TIER=false
# Questions per signed-in user per 24 hours.
CHAT_DAILY_LIMIT=40

# Set to 1 when running behind a reverse proxy / hosting load balancer.
TRUST_PROXY=

# Hosted libSQL (e.g. Turso) instead of a local file: DATABASE_URL="libsql://..."
DATABASE_AUTH_TOKEN=
